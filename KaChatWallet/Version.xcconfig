// Local, gitignored secrets (API keys). Optional include: missing file is fine - the app
// builds with empty keys. Copy Secrets.xcconfig.example to Secrets.xcconfig and fill in real
// values.
#include? "Secrets.xcconfig"

// KaChat Wallet's version and build number - the one place to change them.
//
// App Store Connect wants each upload's build number (CFBundleVersion) strictly above the last
// one within the same marketing version; a new marketing version starts again at 1. Bump
// CURRENT_PROJECT_VERSION (and KACHAT_BUILD_NUMBER with it) before each upload.
//
// About and the sign-in screen show "<MARKETING_VERSION> (<build>)", or just the marketing
// version once KACHAT_IS_RELEASE is YES for an App Store release (see AppVersion.display).
KACHAT_BUILD_NUMBER = 5
KACHAT_IS_RELEASE = NO
CURRENT_PROJECT_VERSION = 5
MARKETING_VERSION = 1.0

// Apple Generic Versioning, so `agvtool` can set CURRENT_PROJECT_VERSION if a build script
// ever needs to.
VERSIONING_SYSTEM = apple-generic
