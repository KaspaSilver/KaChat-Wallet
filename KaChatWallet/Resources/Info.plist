<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.kachat.wallet.messageFetch</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kachat.wallet</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kapay</string>
				<string>kachatwallet</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(KACHAT_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>KaChatBuildNumber</key>
	<string>$(KACHAT_BUILD_NUMBER)</string>
	<key>KaChatIsRelease</key>
	<string>$(KACHAT_IS_RELEASE)</string>
	<key>NSCameraUsageDescription</key>
	<string>KaPay uses the camera to scan QR codes: Kaspa addresses, payment requests and Cold Storage signing.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID is used to unlock your seed phrase and sign back in, when enabled in Settings.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>KaPay connects to your local network only if you point it at your own Kaspa node or Nextcloud server.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save QR codes and images you choose to your photo library.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
